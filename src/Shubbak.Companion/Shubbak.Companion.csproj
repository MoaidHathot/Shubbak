<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shubbak.Companion - what the bar, the palette and the watcher have in common.

    Three programs sit beside the window manager as clients of its pipe, and each
    grew the same plumbing on its own: the help-and-version preamble, the
    single-instance lock, the log file named after the program, the DPI opt-in, a
    window class with a window procedure that must never throw, a message loop that
    waits rather than polls, and a subscription that reconnects for as long as the
    process lives. Three copies meant three places for one fix - the lock claimed
    after the log was opened, so a duplicate truncated the running copy's log, was
    fixed three times - and none of the three was tested, because a static Program
    with a dozen static fields cannot be.

    This is the one copy. Everything in it is what a client of the window manager
    needs and nothing that any one client is about; the bar's appbar reservation and
    the palette's foreground fight stay where they are.

    Win32 handles cross this assembly's boundary as nint. CsWin32 generates its types
    internal to each project, so an HWND here is not the HWND the bar's own manifest
    generates, and a base class that took one would fit no derived class.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(ShubbakRid)</RuntimeIdentifier>
    <RootNamespace>Shubbak.Companion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shubbak.Core\Shubbak.Core.csproj" />
    <ProjectReference Include="..\Shubbak.Config\Shubbak.Config.csproj" />
    <ProjectReference Include="..\Shubbak.Ipc\Shubbak.Ipc.csproj" />
    <ProjectReference Include="..\Shubbak.Native\Shubbak.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shubbak.Companion.Tests" />
  </ItemGroup>

</Project>
