<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The GDI implementation of IRenderer, and the only project below Shubbak.Ui that
    knows a drawing API exists. Kept separate from Shubbak.Ui so that the visual
    tree and the flex layout stay testable without a window on screen, and so a
    Direct2D renderer can be added later as a sibling rather than a rewrite.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RootNamespace>Shubbak.Ui.Gdi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shubbak.Ui\Shubbak.Ui.csproj" />
  </ItemGroup>

</Project>
