<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>

    <!--
      Platforms lists what may be selected; it does not select anything, so this
      project was once compiling as AnyCPU.

      That is not merely untidy. Some Win32 APIs have a different shape per
      architecture - NOTIFYICONDATAW contains a union whose size differs - and CsWin32
      refuses to generate those at all for AnyCPU, because there is no single correct
      answer. The tray icon is the first thing here to need one.

      So the target is always concrete, and it is the same one the executables are
      built for: ShubbakRid from Directory.Build.props, x64 unless told otherwise, from
      which the SDK derives PlatformTarget. Taken here rather than inherited from the
      referencing executable, because a RuntimeIdentifier does not travel down a
      ProjectReference - a library is built once, architecture-neutral, however its
      callers are built - and a neutral build of this project is an x64 one.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(ShubbakRid)</RuntimeIdentifier>

    <RootNamespace>Shubbak.Native</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shubbak.Core\Shubbak.Core.csproj" />
  </ItemGroup>

  <!--
    No InternalsVisibleTo, deliberately. The test project generates its own CsWin32
    PInvoke class, and opening this project's internals to it makes the two collide
    (CS0436) on every generated type both sides use. Anything a test needs from here is
    public, and takes public types.
  -->

</Project>
