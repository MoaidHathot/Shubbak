<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>shubbak</AssemblyName>
    <!-- The name Task Manager shows. See the note in Directory.Build.props. -->
    <AssemblyTitle>Shubbak CLI</AssemblyTitle>
    <RootNamespace>Shubbak.Cli</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Regenerate with tools/make-icons.ps1. -->
    <ApplicationIcon>..\icons\shubbak.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shubbak.Ipc\Shubbak.Ipc.csproj" />
    <ProjectReference Include="..\Shubbak.Native\Shubbak.Native.csproj" />
    <ProjectReference Include="..\Shubbak.Config\Shubbak.Config.csproj" />

    <!--
      So check-config validates the whole file rather than half of it. The bar's
      section is in the same config, and a typo in it was reported nowhere at all.
      Taj.Core is the pure model - no drawing, no Win32 - so this costs the CLI
      nothing but the parser it already needed.

      Dalil.Core is here for the same reason and the same shape: the palette's
      section was on the allow-list by name and checked by nothing, so a misspelt
      setting was accepted in silence and did nothing for ever. It is also pure -
      the matcher and the model, no Win32 - and it already depends on
      Shubbak.Config for the command parser it validates actions with.
    -->
    <ProjectReference Include="..\Taj.Core\Taj.Core.csproj" />
    <ProjectReference Include="..\Dalil.Core\Dalil.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Autostart composes and reads back a Windows command line. The quoting is the
      part worth holding to account and it is not reachable from outside.
    -->
    <InternalsVisibleTo Include="Shubbak.Cli.Tests" />
  </ItemGroup>

</Project>
