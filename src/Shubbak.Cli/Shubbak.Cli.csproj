<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>shubbak</AssemblyName>
    <RootNamespace>Shubbak.Cli</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shubbak.Ipc\Shubbak.Ipc.csproj" />
    <ProjectReference Include="..\Shubbak.Native\Shubbak.Native.csproj" />
    <ProjectReference Include="..\Shubbak.Config\Shubbak.Config.csproj" />
  </ItemGroup>

</Project>
