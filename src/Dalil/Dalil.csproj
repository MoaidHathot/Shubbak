<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dalil (دليل, "guide") - the searchable index over everything Shubbak can see.

    A resident process of its own rather than a mode of the bar. A palette is a
    Shubbak feature, not a bar feature: hosting it in Taj would mean anyone
    preferring a different bar loses it, and would put a window index inside
    something whose job is displaying state.

    Resident because it must open faster than the eye. The window is created hidden
    at startup and only shown, so a signal costs a ShowWindow rather than a process
    start - which for a framework-dependent build is tens of milliseconds before any
    window exists, with a tail that depends on the antivirus.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>dalil</AssemblyName>
    <!-- The name Task Manager shows. See the note in Directory.Build.props. -->
    <AssemblyTitle>Shubbak Dalil</AssemblyTitle>
    <RootNamespace>Dalil</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Regenerate with tools/make-icons.ps1. -->
    <ApplicationIcon>..\icons\dalil.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dalil.Core\Dalil.Core.csproj" />
    <ProjectReference Include="..\Shubbak.Ui.Gdi\Shubbak.Ui.Gdi.csproj" />
    <ProjectReference Include="..\Shubbak.Ipc\Shubbak.Ipc.csproj" />
    <ProjectReference Include="..\Shubbak.Config\Shubbak.Config.csproj" />

    <!--
      For ConsoleHost. A GUI-subsystem binary has no console, so the version and help
      switches would print into nothing without it. See the longer note in Taj.csproj.
    -->
    <ProjectReference Include="..\Shubbak.Native\Shubbak.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      What a keystroke means is decided in PaletteInput, which is internal because
      nothing outside this process has any business asking. It is also the part most
      worth holding to account: the window it used to live in cannot be constructed
      without a real HWND, a message loop and a device context, so none of those
      judgements could be tested at all.
    -->
    <InternalsVisibleTo Include="Dalil.Tests" />
  </ItemGroup>

</Project>
