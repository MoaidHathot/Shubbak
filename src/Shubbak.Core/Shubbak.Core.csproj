<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Log.ResetForTests is internal on purpose: production code must never be able
      to reset the logger, but tests must, because Log is process-wide state.
    -->
    <InternalsVisibleTo Include="Shubbak.Core.Tests" />

    <!--
      CommandCatalogue.ResetForTests, for the same reason. The test that needs it
      lives with the parser it holds to account, which is in Shubbak.Config.
    -->
    <InternalsVisibleTo Include="Shubbak.Config.Tests" />
  </ItemGroup>

</Project>
