<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A GUI-subsystem binary, despite having no window and writing to a console.

      The subsystem is a field in the PE header, read by the loader before any of our
      code runs. A console-subsystem process launched by something that has no console
      of its own - Explorer, a shortcut, Task Scheduler, the Run key - has one
      allocated for it, and it stays for the life of the process. For a daemon started
      at logon that is a permanent black window on the desktop, and no runtime flag
      can suppress it because the decision precedes us.

      The cost is that a console has to be asked for when one is genuinely wanted, so
      the foreground switch and the startup-failure path both go through ConsoleHost.
      See the remarks there; the trade is deliberate and the alternative was making
      autostart launch the daemon through a hidden PowerShell, which is both a visible
      flash and the exact process tree an antivirus heuristic is built to distrust.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>shubbak-wm</AssemblyName>
    <!-- The name Task Manager shows. See the note in Directory.Build.props. -->
    <AssemblyTitle>Shubbak Window Manager</AssemblyTitle>
    <RootNamespace>Shubbak.Wm</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      Regenerate with tools/make-icons.ps1. Without one, Task Manager's Startup tab
      and any shortcut an installer creates show the generic placeholder, which is
      the first impression a packaged build makes.
    -->
    <ApplicationIcon>..\icons\shubbak-wm.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Published as NativeAOT per ADR 0001: ~1.7 MB, no runtime prerequisite. -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>

    <!-- The animation and hook paths must not be perturbed by server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!--
      uiAccess is what lets the window manager position windows belonging to
      higher-integrity processes - Task Manager and anything else started as
      administrator. Windows only honours it for a signed binary installed under
      Program Files, and a uiAccess binary that fails those checks does not run
      without the privilege, it fails to launch. So it is opt-in at package time and
      off everywhere else, including here.

        dotnet publish -p:ShubbakUiAccess=true

      The two manifests differ by one attribute. Everything that depends on the
      answer asks the running process rather than assuming, so nothing else changes
      between the two builds.

      Clean before switching. The manifest is baked into the apphost during build and
      MSBuild does not treat this property as an input to it, so publishing with the
      flag and then without it silently reuses the first apphost. A uiAccess binary
      that is not signed and not under Program Files does not start at all - it fails
      with "A referral was returned from the server" - so a stale one is a build that
      cannot run, with nothing in the output to say why. Verified, not theorised.
    -->
    <ShubbakUiAccess Condition="'$(ShubbakUiAccess)' == ''">false</ShubbakUiAccess>

    <ApplicationManifest Condition="'$(ShubbakUiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(ShubbakUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The version in a manifest's assemblyIdentity is written by hand and read by
    nobody: Windows ignores it for an application that is not side-by-side assembled,
    so nothing breaks when it is wrong. It sat at the SDK's placeholder 1.0.0.0 while
    the product was 0.9.0, which is a false statement in a file whose whole purpose is
    to state things about this binary.

    Checked rather than generated. Generating it means rewriting XML through MSBuild
    string functions during the build, and the failure mode of getting that wrong is a
    corrupt manifest, which is a far worse outcome than the stale number it would be
    fixing. Checked rather than remembered, because remembering is what failed.

    Both files are checked, not just the one selected, or bumping the version would
    keep passing until the day somebody published a uiAccess build.
  -->
  <Target Name="VerifyManifestVersions" BeforeTargets="PrepareForBuild" DependsOnTargets="GetAssemblyVersion">
    <PropertyGroup>
      <_ExpectedIdentity>version="$(AssemblyVersion)" name="Shubbak.Wm"</_ExpectedIdentity>
    </PropertyGroup>

    <Error
      Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.manifest').Contains('$(_ExpectedIdentity)'))"
      Text="app.manifest declares a different assemblyIdentity than the build. Expected: $(_ExpectedIdentity). Update it to match &lt;Version&gt; in Directory.Build.props." />

    <Error
      Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.uiaccess.manifest').Contains('$(_ExpectedIdentity)'))"
      Text="app.uiaccess.manifest declares a different assemblyIdentity than the build. Expected: $(_ExpectedIdentity). Update it to match &lt;Version&gt; in Directory.Build.props." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Shubbak.Core\Shubbak.Core.csproj" />
    <ProjectReference Include="..\Shubbak.Native\Shubbak.Native.csproj" />
    <ProjectReference Include="..\Shubbak.Config\Shubbak.Config.csproj" />
    <ProjectReference Include="..\Shubbak.Ipc\Shubbak.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The daemon's interesting methods are internal, which left the parts most worth
      testing - command dispatch, window inspection, the diagnostic report - with no
      way to reach them at all.
    -->
    <InternalsVisibleTo Include="Shubbak.Wm.Tests" />
  </ItemGroup>

</Project>
