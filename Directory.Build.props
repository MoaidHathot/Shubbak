<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- We do not require an XML doc comment on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Task Manager's Processes tab shows the Win32 FileDescription resource, which
    comes from AssemblyTitle - not from the file name. Left unset, the SDK derives
    the whole version resource from AssemblyName, so the bar listed itself as "taj"
    and the daemon as "shubbak-wm", sorted pages apart, and CompanyName came out as
    the assembly name too. Titling all of them "Shubbak ..." groups them without
    renaming a binary, which matters because a rename would break the
    `process = "taj"` window rule and every script that launches the bar by name.

    AssemblyTitle is set per executable, next to its AssemblyName. Only the shared
    identity lives here. Nothing in Shubbak reads assembly metadata to decide
    anything, so this is display only - with one exception: the Version below is
    what `shubbak diagnose` reports, which was previously the SDK's placeholder
    1.0.0.0 and therefore said nothing about which build a report came from.
  -->
  <PropertyGroup>
    <Product>Shubbak</Product>
    <Company>Moaid Hathot</Company>
    <Copyright>Copyright (c) 2026 Moaid Hathot</Copyright>
    <Version>0.10.0</Version>
  </PropertyGroup>

  <!--
    Nothing is a NuGet package unless it says so. The SDK's default is that every
    library is packable, which made `dotnet pack` at the solution level try to pack
    fifteen projects, fourteen of which are Win32-bound executables and their
    innards. One project opts in: Shubbak.Ipc, the protocol and its client, which is
    what a program of somebody else's needs to talk to the window manager. The
    identity a package carries beyond the assembly's is here, once, so a second
    package would say the same things.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Moaid Hathot</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MoaidHathot/Shubbak</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MoaidHathot/Shubbak</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Set by CI so a package built there is reproducible from its source link. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The architecture the executables and the test hosts are built for when nothing
    says otherwise: x64, which is what every developer machine so far has been.

    Each executable and test project takes this as its RuntimeIdentifier unless one
    was given, so `dotnet build -p:ShubbakRid=win-arm64` builds and tests the whole
    solution natively on an ARM64 machine - which is what the ARM64 job in CI does.
    A property of its own rather than RuntimeIdentifier itself because the SDK
    refuses a RuntimeIdentifier at the solution level (NETSDK1134); the libraries stay
    architecture-neutral either way, and a RuntimeIdentifier given to dotnet publish still wins for a
    single project. Shubbak.Native is the one library that has to be compiled for a
    concrete architecture, and it follows whichever RID reaches it.
  -->
  <PropertyGroup>
    <ShubbakRid Condition="'$(ShubbakRid)' == ''">win-x64</ShubbakRid>
  </PropertyGroup>

</Project>
